# Konfiguracja wdrożenia projektu (vendor/bin/simplysmart deploy <projekt>), uruchamianego w tym projekcie bazowym.
# Skopiuj jako infrastructure/deploy-vendors/<projekt>.env (katalog jest w .gitignore), np. deploy-vendors/shop.env.
# Konta pierwszej instalacji projektu: deploy-vendors/<projekt>.onboarding.env (format jak deploy.onboarding.env.example).
# Format KLUCZ=wartość; wartości ze spacjami w cudzysłowie ("…" albo '…'), komentarz po #.

# --- Przed-produkcja: katalog projektu na tym komputerze --------------------------------------------------------
# Klon repozytorium projektu z własnym .env (deploy go nie zmienia). Aktualizowany przed każdym wdrożeniem produkcji
# tym samym skryptem co serwer: git pull, composer z manifestu bez narzędzi deweloperskich, migracje, seedy, cache.
PREPRODUCTION_PATH=/var/www/shop-staging

# PHP 8.4+ na tym komputerze. Pusty = php.
PREPRODUCTION_PHP=

# Plik Composera (phar) dla skryptu. Pusty = composer z PATH.
PREPRODUCTION_COMPOSER=

# --- Produkcja: serwer (po potwierdzeniu pytania albo z --production) ---------------------------------------------
# Konto SSH serwera, np. login@serwer.hosting.pl (albo alias z ~/.ssh/config)
DEPLOY_SSH=

# Katalog aplikacji na serwerze (repozytorium git projektu), np. ~/moja-domena.pl
DEPLOY_PATH=

# PHP 8.4 na serwerze (na hostingu współdzielonym domyślne `php` bywa starsze)
DEPLOY_PHP=php84

# Plik Composera na serwerze (uruchamiany przez DEPLOY_PHP), np. composer.phar w katalogu aplikacji.
# Pusty = ~/bin/composer (skrypt zainstaluje go, gdy go nie ma; nie instaluje composer.phar wskazanego tutaj).
REMOTE_COMPOSER=

# Polecenie Composera na komputerze deweloperskim (manifest), np. "php composer.phar". Pusty = `composer`.
LOCAL_COMPOSER=

# Token GitHub tylko do odczytu (fine-grained, „Contents: read” dla repozytoriów paczek, także prywatnych).
# Potrzebny raz: skrypt zapisze go w konfiguracji Composera na serwerze. Pusty = token już jest na serwerze.
GITHUB_TOKEN=
