# Konfiguracja wdrożenia (vendor/bin/simplysmart deploy). Skopiuj jako infrastructure/deploy.env (plik jest w .gitignore).
# Format KLUCZ=wartość; wartości ze spacjami w cudzysłowie ("…" albo '…'), komentarz po #.

# Konto SSH serwera, np. login@serwer.hosting.pl (albo alias z ~/.ssh/config)
DEPLOY_SSH=

# Katalog aplikacji na serwerze (repozytorium git skeletonu), np. ~/moja-domena.pl
DEPLOY_PATH=

# PHP 8.4 na serwerze (na hostingu współdzielonym domyślne `php` bywa starsze)
DEPLOY_PHP=php84

# Plik Composera na serwerze (uruchamiany przez DEPLOY_PHP), np. composer.phar w katalogu aplikacji.
# Pusty = ~/bin/composer (skrypt zainstaluje go, gdy go nie ma; nie instaluje composer.phar wskazanego tutaj).
REMOTE_COMPOSER=

# Polecenie Composera na komputerze deweloperskim, np. "php composer.phar". Pusty = `composer`.
LOCAL_COMPOSER=

# Token GitHub tylko do odczytu (fine-grained, „Contents: read” dla repozytoriów paczek, także prywatnych).
# Potrzebny raz: skrypt zapisze go w konfiguracji Composera na serwerze. Pusty = token już jest na serwerze.
GITHUB_TOKEN=
