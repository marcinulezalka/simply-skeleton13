# Wartości pierwszej instalacji (vendor/bin/simplysmart deploy:onboarding). Skopiuj jako
# infrastructure/deploy.onboarding.env (plik jest w .gitignore) i uzupełnij.
# Format KLUCZ=wartość; wartości ze spacjami w cudzysłowie ("…" albo '…'), komentarz po #.
#
# Konta: ONBOARD_ACCOUNT_<n>_… z kolejnymi numerami. Każde konto zakłada na serwerze polecenie strefy
# `<strefa>:account:create` z `--skip-existing`, więc istniejący adres jest pomijany i onboarding można powtórzyć.
# Hasła nie ma: PIN właściciel konta ustawia przy pierwszym logowaniu.

# Strefa (nazwa z polecenia `<strefa>:account:create`), adres e-mail, imię i nazwisko — wymagane
ONBOARD_ACCOUNT_1_ZONE=admiro
ONBOARD_ACCOUNT_1_EMAIL=
ONBOARD_ACCOUNT_1_NAME=

# Role konta po przecinku (opcjonalnie); pierwszy administrator panelu dostaje rolę hero
ONBOARD_ACCOUNT_1_ROLES=hero

# Token organizacji ról, tylko w strefie z organizacjami klientów (opcjonalnie)
ONBOARD_ACCOUNT_1_ORGANIZATION=
