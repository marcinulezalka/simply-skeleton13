APP_NAME=simplysmart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL="https://localhost:8080"

APP_LOCALE=pl
# Włączone języki stref, np. pl,en (jeden = trasy bez prefiksu {locale})
APP_LOCALES=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skeleton13
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Sesja strefy z logowaniem (minuty), zaufane proxy (* albo adresy), nagłówki HSTS i CSP
ZONE_SESSION_LIFETIME=30
# TRUSTED_PROXIES=
SECURITY_HSTS=true
SECURITY_CSP=true
# Segment URL strefy administratorów (simplysmart/admiro); nie może być kodem języka
ADMIRO_SLUG=admiro
# Logowanie stref: ważność kodu (minuty), długość PIN-u, kanał dziennika logowań
AUTH_CODE_TTL=10
AUTH_PIN_LENGTH=6
AUTH_LOG_CHANNEL=sign_in

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME="noreply@example.com"
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
