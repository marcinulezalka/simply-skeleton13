APP_NAME=simplysmart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL="https://localhost:8080"

APP_LOCALE=pl
# Włączone języki stref, np. pl,en (jeden = trasy bez prefiksu {locale})
APP_LOCALES=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL
# Kraj aplikacji (ISO 3166-1) i stawka VAT (%) używane, dopóki słowniki lokalizacji ich nie mają
APP_COUNTRY=PL
APP_DEFAULT_VAT=23
# Kursy walut z tabeli A NBP: godzina pobierania w dni robocze (pusta wyłącza), ile dni wstecz
EXCHANGE_RATES_SCHEDULE_AT=12:30
EXCHANGE_RATES_DAYS_BACK=7
# Zgoda na cookies: baner po opublikowaniu polityki cookies w panelu administratorów
COOKIE_CONSENT=true
# Administrator danych w pierwszych wersjach polityk (admiro:legal:seed): imię i nazwisko albo nazwa i e-mail, bez adresu
# LEGAL_CONTROLLER_NAME=
# LEGAL_CONTROLLER_EMAIL=
# Święta i dni wolne krajów z Nager.Date pobierane co miesiąc (false wyłącza)
HOLIDAYS_SCHEDULE=true

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=skeleton13
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Sesja strefy z logowaniem (minuty), zaufane proxy (* albo adresy), nagłówki HSTS i CSP,
# maskowanie błędów jako 404 (puste = tylko na produkcji)
ZONE_SESSION_LIFETIME=30
# TRUSTED_PROXIES=
SECURITY_HSTS=true
SECURITY_CSP=true
# SECURITY_MASK_ERRORS=
# Segment URL strefy administratorów (simplysmart/admiro), nie może być kodem języka; zaufane urządzenia administratorów
ADMIRO_SLUG=admiro
ADMIRO_TRUSTED_DEVICES=false
ADMIRO_PIN_MIN_LENGTH=8
# Logowanie stref: ważność kodu (minuty), zakres długości PIN-u (4–16 cyfr), kanał dziennika logowań, zaufane urządzenia (dni)
AUTH_CODE_TTL=10
AUTH_PIN_MIN_LENGTH=4
AUTH_PIN_MAX_LENGTH=16
# Układ stron logowania: centered (jedna karta) albo split (marka i formularz obok siebie)
AUTH_LAYOUT=centered
AUTH_LOG_CHANNEL=sign_in
AUTH_TRUSTED_DEVICES=true
AUTH_TRUSTED_DEVICE_DAYS=30

# Pułapki na boty: fałszywe logowanie pod adresami botów, pułapka w formularzu logowania, ban (minuty),
# adresy nigdy nie banowane (CIDR, przecinki), kanał dziennika
HONEYPOT_ROUTES=false
HONEYPOT_FORMS=false
HONEYPOT_BAN_MINUTES=1440
# HONEYPOT_WHITELIST=
HONEYPOT_LOG_CHANNEL=honeypot

# Strona design systemu /design-system (puste = tylko poza produkcją)
# DESIGN_SYSTEM_PAGE=
# Dziennik zdarzeń (tabela audit_events): ile dni trzymać wpisy
AUDIT_RETENTION_DAYS=365

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
MAIL_SCHEME=smtp
MAIL_REQUIRE_TLS=true
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME="noreply@example.com"
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=example.com

# Dysk plików marki organizacji (logo w e-mailach; prywatny, domyślnie local)
ADMIRO_ORGANIZATION_BRAND_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
