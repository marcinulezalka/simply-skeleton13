{
    "zone": "alpha",
    "permissions": ["reports.view", "reports.export", "notes.manage", "users.manage"],
    "roles": {
        "guest": {"permissions": []},
        "support": {"permissions": ["reports.view"]},
        "analyst": {"permissions": ["reports.view", "reports.export"]},
        "manager": {"inherits": ["analyst"], "permissions": ["notes.manage", "users.manage"]},
        "owner": {"permissions": "*", "except": ["users.manage"]},
        "hero": {"permissions": "*"}
    }
}
